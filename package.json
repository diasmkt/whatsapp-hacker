    "axios": "^1.13.6",
    "axios-hooks": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie": "^0.7.2",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.34.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
